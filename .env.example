# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5433/rental
# Set to true to require SSL (auto-enabled in production)
DB_SSL=false
# First-run auto-setup creates the target database (if your connection
# user has CREATEDB) and applies pending Drizzle migrations.
# - Enabled by default in development.
# - Disabled by default in production. Set AUTO_DB_SETUP=true only if you
#   want serverless cold starts to migrate; otherwise run
#   `npm run db:migrate` as part of your deploy pipeline.
# - Set SKIP_DB_SETUP=true to disable in any environment.
# SKIP_DB_SETUP=false
# AUTO_DB_SETUP=false

# ---- Auth ----
# Generate with: openssl rand -base64 32
JWT_SECRET=
# Optional: cookie name + lifetime (defaults: rms_session, 1d)
SESSION_COOKIE_NAME=rms_session
SESSION_TTL_SECONDS=86400

# ---- Frontend / CORS ----
# Comma-separated list of allowed origins for cross-origin API consumers
CORS_ORIGIN=http://localhost:3000
# Used by password-reset emails to build the reset link
FRONTEND_URL=http://localhost:3000

# ---- SMTP (password reset + billing reminders) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_NAME=Rental Management
FROM_EMAIL=

# ---- Cron auth (Vercel Cron) ----
# Generate with: openssl rand -base64 32. Vercel Cron sends this in the
# `Authorization: Bearer <secret>` header to /api/cron/* routes.
CRON_SECRET=

# ---- Logging ----
# Optional. Defaults to 'debug' in development, 'info' in production.
# LOG_LEVEL=info
